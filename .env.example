# -----------------------------------------------------------------------------
# Bahar - Resilient Athletic Training Engine
# Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NOTE: Bahar is 100% functional in offline-first mode without any cloud credentials.
# All baseline profiles, daily envelopes, and training history default to local IndexedDB (Dexie).
# -----------------------------------------------------------------------------

# Supabase Configuration (Optional - for cloud sync, multiplayer buddy pairs, and public spots)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Open-Weight AI Model Gateway (Optional)
# -----------------------------------------------------------------------------
# Point to any OpenAI-compatible server hosting an open-weight model:
# - Local Ollama:   AI_BASE_URL=http://localhost:11434/v1, AI_MODEL=gemma2:2b (or llama3.2:3b)
# - Local vLLM:     AI_BASE_URL=http://localhost:8000/v1,  AI_MODEL=meta-llama/Llama-3.2-3B-Instruct
# - Hugging Face:   AI_BASE_URL=https://api-inference.huggingface.co/v1, AI_MODEL=..., AI_API_KEY=hf_...
# - OpenRouter:     AI_BASE_URL=https://openrouter.ai/api/v1, AI_MODEL=google/gemma-2-9b-it:free, AI_API_KEY=...
#
# If unset, Bahar gracefully returns 503 and activates its deterministic offline
# sports-science plan bank.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=gemma2:2b
AI_API_KEY=

# Sentry Monitoring & Error Reporting (Optional)
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
